    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.6",
    "@types/three": "^0.186.0",
